<div class="mt-controls">
  <button type="button" data-action="scan" {{#if scanDisabled}}disabled{{/if}}>SCAN</button>
  {{#if power}}
  <div class="mt-power level-{{power.level}}">
    <div class="mt-battery" title="Power: {{power.value}}">
      <span class="mt-battery-label">POWER {{power.value}}</span>
      {{#each power.cells}}<i class="{{#if this}}full{{/if}}"></i>{{/each}}
    </div>
    <button type="button" data-action="power" {{#if powerDisabled}}disabled{{/if}} {{#unless power.value}}disabled{{/unless}}>POWER CHECK</button>
  </div>
  {{/if}}
  {{#if power}}{{#if isGM}}
  <div class="mt-power mt-power-gm">
    <span class="mt-battery-label">GM POWER</span>
    <button type="button" data-action="powerDown" {{#unless power.value}}disabled{{/unless}}>−1</button>
    <button type="button" data-action="powerUp" {{#if power.atMax}}disabled{{/if}}>+1</button>
    <button type="button" data-action="recharge" {{#if power.atMax}}disabled{{/if}}>RECHARGE (5)</button>
  </div>
  {{/if}}{{/if}}
  {{#if powerResult}}
  <div class="mt-power-result {{powerResult.tone}}">
    <strong>{{powerResult.headline}}</strong>
    <ul>{{#each powerResult.lines}}<li>{{this}}</li>{{/each}}</ul>
  </div>
  {{/if}}
  {{#if isGM}}
  <button type="button" data-action="lock" class="{{#if locked}}on{{/if}}">{{#if locked}}LOCKED{{else}}UNLOCKED{{/if}}</button>
  <button type="button" data-action="continuous" class="{{#if continuous}}on{{/if}}">CONTINUOUS</button>
  <fieldset class="mt-viewers">
    <legend>Show to</legend>
    {{#each users}}
    <label><input type="checkbox" data-viewer="{{id}}" {{#if checked}}checked{{/if}}> {{name}}</label>
    {{/each}}
  </fieldset>
  {{/if}}
</div>
